{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['isOnline', 'lastSeenAt'])",
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeenAt": {
          ".validate": "newData.isNumber()"
        },
        "lastLoginAt": {
          ".validate": "newData.isNumber()"
        },
        "registrationNumber": {
          ".validate": "newData.isString()"
        },
        "role": {
          ".validate": "newData.isString()"
        }
      }
    },
    "monitoring": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}

