rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : null;
    }

    function isMasterAdmin() {
      return getUserRole() == 'MASTER_ADMIN';
    }

    function isStaffMember() {
      return getUserRole() in ['STAFF', 'HOD', 'AHOD'];
    }

    function isHOD() {
      return getUserRole() in ['HOD', 'AHOD', 'MASTER_ADMIN'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection: Auth mapping & metadata
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isMasterAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'registrationNumber', 'department'])
      );
      allow delete: if isMasterAdmin();
    }

    // 2. Students collection: Preloaded & student profiles
    match /students/{studentId} {
      allow read: if true; // Publicly readable for student directory, pre-login verification and cross-dashboard visibility
      allow create, delete: if isMasterAdmin();
      allow update: if isMasterAdmin() || isStaffMember() || (
        isAuthenticated() && (
          // Student editing their own permitted profile fields
          (resource.data.uid == request.auth.uid && 
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['registrationNumber', 'department', 'academicYear', 'section', 'status', 'isActivated'])) ||
          // First-time activation linking UID
          (!resource.data.hasSetPassword && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'hasSetPassword', 'isActivated', 'profilePhotoUrl', 'profilePhotoPublicId', 'mobile', 'email', 'updatedAt', 'lastLoginAt']))
        )
      );
    }

    // 3. Staff collection: Staff directory & pending role requests
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create: if true; // Allow new faculty registration requests
      allow update: if isMasterAdmin() || isStaffMember() || (
        isAuthenticated() && request.auth.uid == staffId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedRole', 'approvalStatus', 'isSuspended'])
      );
      allow delete: if isMasterAdmin();
    }

    // 4. Event Applications: Lifecycle management
    match /eventApplications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isMasterAdmin() || (
        isAuthenticated() && resource.data.studentId == request.auth.uid && resource.data.status == 'DRAFT'
      );
    }

    // 5. Team Memberships
    match /teamMemberships/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isMasterAdmin() || (isAuthenticated() && resource.data.leaderUid == request.auth.uid);
    }

    // 6. Approvals: Official audit records for verification steps
    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isMasterAdmin();
    }

    // 7. Event Categories: Dynamic category catalogue
    match /eventCategories/{categoryId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // 8. Academic Sections & Departments
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // 9. Notifications: Individual user inbox & broadcast
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 10. Audit Logs: Tamper-proof system activity log
    match /auditLogs/{logId} {
      allow read: if isStaffMember() || isMasterAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 11. System Settings & Global Configurations
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 12. Student Registration Requests (Approvals queue)
    match /studentRegistrationRequests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffMember() || isMasterAdmin() || isAuthenticated();
    }

    // 13. Support Issues & Help Desk
    match /supportIssues/{issueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
  }
}
